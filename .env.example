# Postgres credentials. docker-compose.yml REQUIRES POSTGRES_PASSWORD (no default) and binds
# Postgres to 127.0.0.1 only. Use the same password in DATABASE_URL below.
# Generate one with: openssl rand -hex 24
# POSTGRES_USER="cma"
# POSTGRES_PASSWORD="<generate-a-strong-password>"

# Postgres connection used by packages/db (Prisma). In production the app refuses to start
# if the password is empty or a well-known default (postgres, password, admin...).
DATABASE_URL="postgresql://cma:<POSTGRES_PASSWORD>@localhost:5432/competitor_monitor?schema=public"

# Redis connection used by packages/queue (BullMQ) and the rate limiter. Redis IS the job queue:
# anyone who can reach it can inject jobs for any organization, so it needs a password and must
# never be exposed. docker-compose.yml REQUIRES REDIS_PASSWORD (no default) and binds Redis to
# 127.0.0.1 only; put the same password in the URL (redis://:PASSWORD@host:6379).
# Generate one with: openssl rand -hex 24
# REDIS_PASSWORD="<generate-a-strong-password>"
REDIS_URL="redis://:<REDIS_PASSWORD>@localhost:6379"

# Secret used to sign session JWTs (apps/web auth) - generate with: openssl rand -hex 32
# The web app and the worker REFUSE TO START if a secret is a placeholder, shorter than 32
# characters, too repetitive, or if AUTH_SECRET and CMA_AI_ENCRYPTION_KEY are the same value.
AUTH_SECRET="replace-with-a-random-64-char-hex-string"

# AI provider (Phase 3/3.1). OPENAI_API_KEY is read only by apps/worker
# (dev/test bootstrap fallback, never in production - see DevRunbook.md
# §7b). CMA_AI_ENCRYPTION_KEY is read by BOTH apps/web (to encrypt a
# customer's AiConnection.apiKey on save) and apps/worker (to decrypt it
# before calling a provider) - required as soon as any organization
# creates an AI connection, regardless of which provider they choose.
OPENAI_API_KEY=""
CMA_AI_ENCRYPTION_KEY="replace-with-a-random-64-char-hex-string"
# CMA_AI_PROVIDER=openai   # unset by default; set to "fake" for local dev/E2E, or "openai" for the dev bootstrap below (never in production)
# CMA_AI_MODEL=""   # REQUIRED to use the CMA_AI_PROVIDER=openai dev bootstrap - there is NO default model.
#                    # Pick whatever model your own OPENAI_API_KEY is entitled to call, e.g. "gpt-4o-mini".
#                    # In production, model always comes from each organization's own AiConnection row instead.

# DANGER - local development / testing ONLY. When set to exactly "true" AND
# NODE_ENV is not "production", the SSRF guard in packages/security allows
# fetching localhost/private/loopback addresses so you can monitor a local
# fixture server. It is a no-op (loopback/private stays blocked) whenever
# NODE_ENV=production, regardless of this value - never rely on that as your
# only safeguard: leave this UNSET in every real deployment.
# CMA_ALLOW_PRIVATE_TARGETS="true"

# Daily report email (Phase 29 / A2). Any standard SMTP account works: a company
# mail server, a personal mailbox, or any transactional service that exposes SMTP.
# Leave CMA_EMAIL_SMTP_HOST unset and reports are still generated and visible in the
# web app, but no email is sent (and nothing is ever recorded as SENT).
# CMA_EMAIL_SMTP_HOST="smtp.example.com"
# CMA_EMAIL_SMTP_PORT="587"            # default 587 (465 when SECURE=ssl)
# CMA_EMAIL_SMTP_SECURE="starttls"     # ssl | starttls | none (default: ssl on port 465, else starttls)
# CMA_EMAIL_SMTP_USER=""               # optional; must be set together with PASS
# CMA_EMAIL_SMTP_PASS=""
# CMA_EMAIL_FROM="alerts@yourcompany.com"
# CMA_EMAIL_FROM_NAME="Competitor Monitor"
# CMA_EMAIL_PROVIDER="console"         # dev only: log instead of sending; never for production

# Abuse and cost limits (Phase 29 / A3). Every line is optional; the value shown is
# the default. A missing or invalid value falls back to the default (a typo never
# turns a limit off). Counters live in Redis, per organization (or per IP for
# login/signup), in fixed windows; if Redis is down the limiter fails open.
# NOTE for the Playwright E2E suite (apps/web/e2e): it signs up many accounts and
# triggers many scans from one address, so start the web server for E2E with these
# raised, e.g. CMA_LIMIT_SIGNUP_PER_HOUR=1000 CMA_LIMIT_LOGIN_ATTEMPTS=1000
# CMA_LIMIT_MANUAL_SCANS_PER_HOUR=1000 CMA_LIMIT_AI_ANALYSES_PER_DAY=1000
# CMA_LIMIT_AI_DIGESTS_PER_DAY=1000 CMA_LIMIT_AI_TEST_PER_HOUR=1000
# CMA_LIMIT_SMTP_TEST_PER_HOUR=1000
# CMA_LIMIT_LOGIN_ATTEMPTS=10          # failed logins per IP+email per window (the per-email-only cap is 5x)
# CMA_LIMIT_LOGIN_WINDOW_MIN=15
# CMA_LIMIT_SIGNUP_PER_HOUR=5          # sign-up attempts per IP
# CMA_LIMIT_MANUAL_SCANS_PER_HOUR=20   # "scan now" clicks per organization (scheduled scans are unaffected)
# CMA_LIMIT_AI_ANALYSES_PER_DAY=30     # per-change AI analyses per organization
# CMA_LIMIT_AI_DIGESTS_PER_DAY=10      # digest AI interpretations per organization
# CMA_LIMIT_AI_TEST_PER_HOUR=10        # AI connection tests per organization
# CMA_LIMIT_SMTP_TEST_PER_HOUR=10      # SMTP test emails per organization
# CMA_LIMIT_COMPETITORS_PER_ORG=25     # competitors per organization (inactive ones count)
# CMA_LIMIT_URLS_PER_ORG=100           # monitored URLs per organization (paused ones count)
# CMA_LIMIT_MIN_SCAN_INTERVAL_MIN=60   # shortest allowed scan interval for a monitored URL

# --- Scheduler: spacing between jobs for the SAME site (Phase 29 B1) ---
# URLs of one host that become due on the same tick are delayed 1x, 2x, 3x... this much (plus
# random jitter up to the second value), so a competitor never receives a burst. 0 disables.
# CMA_SCHEDULER_HOST_SPACING_MS=30000
# CMA_SCHEDULER_HOST_JITTER_MS=10000

# --- Automatic stop of dead sources (Phase 29 B2) ---
# A source is stopped (paused, history kept, customer can resume) when it has failed at least
# MIN_FAILURES times in a row AND has had no successful scan for AFTER_DAYS days.
# CMA_SOURCE_DISABLE_AFTER_DAYS=14
# CMA_SOURCE_DISABLE_MIN_FAILURES=10
