# Postgres connection used by packages/db (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/competitor_monitor?schema=public"

# Redis connection used by packages/queue (BullMQ)
REDIS_URL="redis://localhost:6379"

# Secret used to sign session JWTs (apps/web auth) - generate with: openssl rand -hex 32
AUTH_SECRET="replace-with-a-random-64-char-hex-string"

# AI provider (Phase 3/3.1). OPENAI_API_KEY is read only by apps/worker
# (dev/test bootstrap fallback, never in production - see DevRunbook.md
# §7b). CMA_AI_ENCRYPTION_KEY is read by BOTH apps/web (to encrypt a
# customer's AiConnection.apiKey on save) and apps/worker (to decrypt it
# before calling a provider) - required as soon as any organization
# creates an AI connection, regardless of which provider they choose.
OPENAI_API_KEY=""
CMA_AI_ENCRYPTION_KEY="replace-with-a-random-64-char-hex-string"
# CMA_AI_PROVIDER=openai   # unset by default; set to "fake" for local dev/E2E, or "openai" for the dev bootstrap below (never in production)
# CMA_AI_MODEL=""   # REQUIRED to use the CMA_AI_PROVIDER=openai dev bootstrap - there is NO default model.
#                    # Pick whatever model your own OPENAI_API_KEY is entitled to call, e.g. "gpt-4o-mini".
#                    # In production, model always comes from each organization's own AiConnection row instead.

# DANGER - local development / testing ONLY. When set to exactly "true" AND
# NODE_ENV is not "production", the SSRF guard in packages/security allows
# fetching localhost/private/loopback addresses so you can monitor a local
# fixture server. It is a no-op (loopback/private stays blocked) whenever
# NODE_ENV=production, regardless of this value - never rely on that as your
# only safeguard: leave this UNSET in every real deployment.
# CMA_ALLOW_PRIVATE_TARGETS="true"

# Daily report email (Phase 29 / A2). Any standard SMTP account works: a company
# mail server, a personal mailbox, or any transactional service that exposes SMTP.
# Leave CMA_EMAIL_SMTP_HOST unset and reports are still generated and visible in the
# web app, but no email is sent (and nothing is ever recorded as SENT).
# CMA_EMAIL_SMTP_HOST="smtp.example.com"
# CMA_EMAIL_SMTP_PORT="587"            # default 587 (465 when SECURE=ssl)
# CMA_EMAIL_SMTP_SECURE="starttls"     # ssl | starttls | none (default: ssl on port 465, else starttls)
# CMA_EMAIL_SMTP_USER=""               # optional; must be set together with PASS
# CMA_EMAIL_SMTP_PASS=""
# CMA_EMAIL_FROM="alerts@yourcompany.com"
# CMA_EMAIL_FROM_NAME="Competitor Monitor"
# CMA_EMAIL_PROVIDER="console"         # dev only: log instead of sending; never for production
