// Competitor Monitor AI - Phase 1 schema.
//
// Every tenant-owned table carries `organizationId` directly (denormalized,
// not just reachable via a join) so that:
//   1. every read/write path can be scoped with a single `WHERE organizationId = ?`
//      instead of relying on a correct chain of joins,
//   2. Postgres row-level security can be added later without a schema change,
//   3. the automated tenant-isolation tests have one column to check everywhere.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (kept in sync by hand with packages/core/src/enums.ts - see that file)
// ---------------------------------------------------------------------------

enum Plan {
  STARTER
  PRO
  BUSINESS
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum UrlCategory {
  PRODUCT_PAGE
  PRICING_PAGE
  GENERAL
}

enum ExtractionMethod {
  HTTP
  CHEERIO
  PLAYWRIGHT
  BROWSER_USE
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum VerificationState {
  CHANGED
  NO_CHANGE
  FAILED_TO_VERIFY
}

enum ChangeType {
  PRICE_CHANGE
  PRODUCT_ADDED
  PRODUCT_REMOVED
  PROMOTION_CHANGE
  CONTENT_CHANGE
}

enum Severity {
  LOW
  MEDIUM
  HIGH
}

enum EntityType {
  PRICE
  PRODUCT
  PLAN
  PROMOTION
  GENERIC
}

// Phase 3: mirrors JobStatus's PENDING -> RUNNING -> COMPLETED/FAILED
// shape deliberately - an AI analysis job is a job with the same
// lifecycle concerns (must reach a terminal state, must be resumable
// after a worker crash), it just calls a different backend.
enum AiAnalysisStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum NotificationChannel {
  EMAIL
}

// Phase 4: PENDING is the reserve-then-resolve idempotency anchor,
// exactly mirroring AiAnalysisStatus's PENDING row created before any
// external call is attempted (see getOrCreatePendingAiAnalysis) - a
// worker crash between reserving this row and actually sending the
// email leaves it correctly recoverable (retry re-sends) rather than
// permanently stuck, since only SENT is ever treated as "done, do not
// resend" (see recordReportEmailResult).
enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// Phase 4: mirrors JobStatus/AiAnalysisStatus's lifecycle shape -
// GENERATING is the "currently being built" state a queue job holds a
// report in between creating it (idempotency anchor) and finishing
// aggregation; a crashed/retried job re-enters this same function and
// finds the row already GENERATING/COMPLETED rather than creating a
// second one. See packages/db/src/repositories/reports.ts.
enum ReportStatus {
  GENERATING
  COMPLETED
  FAILED
}

// ---------------------------------------------------------------------------
// Tenant root
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  plan      Plan     @default(STARTER)
  // Phase 4 (Section 3): the IANA timezone used to compute this
  // organization's "calendar day" reporting window - e.g. "Europe/Berlin".
  // Defaults to "UTC" so a customer who never sets one gets a well-defined,
  // documented boundary rather than an ambiguous mix of server-local and
  // UTC times (see packages/core/src/reportWindow.ts).
  timezone  String   @default("UTC")
  // Phase 4: whether the scheduler should enqueue a daily report job for
  // this organization at all. Deliberately a single boolean, not a cron
  // expression - Section 11 asks for the minimum scheduling necessary.
  dailyReportEnabled Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  competitors   Competitor[]
  usageRecords  UsageRecord[]
  reports       Report[]
  aiConnections AiConnection[]

  @@map("organizations")
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String       @unique
  passwordHash   String
  name           String?
  role           UserRole     @default(OWNER)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Competitors & monitored pages
// ---------------------------------------------------------------------------

model Competitor {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  website        String?
  notes          String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  monitoredUrls MonitoredUrl[]

  @@index([organizationId])
  @@map("competitors")
}

model MonitoredUrl {
  id             String     @id @default(cuid())
  organizationId String
  competitorId   String
  competitor     Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  url                     String
  label                   String?
  category                UrlCategory @default(GENERAL)
  scanFrequencyMinutes    Int         @default(1440)
  // Escalation flags for later tiers - read but not acted on by Phase 1's
  // pipeline (only HttpExtractor/CheerioExtractor exist so far).
  requiresJs              Boolean     @default(false)
  requiresInteraction     Boolean     @default(false)
  isActive                Boolean     @default(true)
  lastSuccessfulScanAt    DateTime?
  consecutiveFailureCount Int         @default(0)
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  monitoringJobs MonitoringJob[]
  snapshots      Snapshot[]
  changeEvents   ChangeEvent[]

  @@index([organizationId])
  @@index([competitorId])
  @@map("monitored_urls")
}

// ---------------------------------------------------------------------------
// Monitoring pipeline
// ---------------------------------------------------------------------------

model MonitoringJob {
  id             String       @id @default(cuid())
  organizationId String
  monitoredUrlId String
  monitoredUrl   MonitoredUrl @relation(fields: [monitoredUrlId], references: [id], onDelete: Cascade)

  status       JobStatus @default(PENDING)
  startedAt    DateTime?
  finishedAt   DateTime?
  errorMessage String?
  createdAt    DateTime  @default(now())

  snapshot    Snapshot?
  usageRecord UsageRecord?

  @@index([organizationId])
  @@index([monitoredUrlId, createdAt])
  @@index([status])
  @@map("monitoring_jobs")
}

model Snapshot {
  id              String        @id @default(cuid())
  organizationId  String
  monitoredUrlId  String
  monitoredUrl    MonitoredUrl  @relation(fields: [monitoredUrlId], references: [id], onDelete: Cascade)
  monitoringJobId String        @unique
  monitoringJob   MonitoringJob @relation(fields: [monitoringJobId], references: [id], onDelete: Cascade)

  fetchedAt         DateTime          @default(now())
  extractionMethod  ExtractionMethod
  httpStatus        Int?
  finalUrl          String?
  verificationState VerificationState
  errorMessage      String?

  normalizedContent  String
  contentHash        String?
  structuredDataHash String?
  confidence         Float
  warnings           Json    @default("[]")

  extractedEntities      ExtractedEntity[]
  changeEventsAsCurrent  ChangeEvent[]     @relation("CurrentSnapshot")
  changeEventsAsPrevious ChangeEvent[]     @relation("PreviousSnapshot")

  @@index([organizationId])
  @@index([monitoredUrlId, fetchedAt])
  @@map("snapshots")
}

model ExtractedEntity {
  id         String   @id @default(cuid())
  snapshotId String
  snapshot   Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  type     EntityType
  key      String
  label    String
  value    String?
  currency String?
  raw      String

  @@index([snapshotId])
  @@index([key])
  @@map("extracted_entities")
}

model ChangeEvent {
  id             String       @id @default(cuid())
  organizationId String
  monitoredUrlId String
  monitoredUrl   MonitoredUrl @relation(fields: [monitoredUrlId], references: [id], onDelete: Cascade)

  previousSnapshotId String?
  previousSnapshot   Snapshot? @relation("PreviousSnapshot", fields: [previousSnapshotId], references: [id], onDelete: SetNull)
  currentSnapshotId  String
  currentSnapshot    Snapshot  @relation("CurrentSnapshot", fields: [currentSnapshotId], references: [id], onDelete: Cascade)

  changeType       ChangeType
  severity         Severity
  confidence       Float
  entityKey        String?
  fieldPath        String
  oldValue         String?
  newValue         String?
  currency         String?
  percentageChange Float?
  evidenceExcerpt  String
  detectedAt       DateTime   @default(now())

  aiAnalysis  AiAnalysis?
  reportItems ReportItem[]

  @@index([organizationId])
  @@index([monitoredUrlId, detectedAt])
  @@map("change_events")
}

// ---------------------------------------------------------------------------
// Downstream stages - tables exist for the relation shape, Phase 1 does not
// write to them (no AI calls, no reports, no notifications sent yet).
// ---------------------------------------------------------------------------

// Phase 3: one AI interpretation per ChangeEvent (the `@unique` below
// is the idempotency guarantee - a duplicate BullMQ delivery or worker
// retry can never create a second row, see aiPipeline.ts's
// runAiAnalysisJob for the accompanying "skip if already COMPLETED"
// check that also avoids a duplicate *paid provider call*, which the
// unique constraint alone would not prevent).
//
// `organizationId` is denormalized here like every other tenant table
// (see schema header) even though it is reachable via changeEvent -
// every read MUST filter on it directly, never rely on the join.
model AiAnalysis {
  id             String      @id @default(cuid())
  organizationId String
  changeEventId  String      @unique
  changeEvent    ChangeEvent @relation(fields: [changeEventId], references: [id], onDelete: Cascade)

  status        AiAnalysisStatus @default(PENDING)
  promptVersion String
  provider      String?
  model         String?

  // The structured output contract (Section 5 of the brief). Stored as
  // Json arrays rather than a normalized table - this is a single
  // small, append-only-per-row blob, not a queryable collection.
  summary         String?
  facts           Json    @default("[]")
  interpretations Json    @default("[]")
  speculation     Json    @default("[]")
  confidence      String?

  inputTokens  Int?
  outputTokens Int?
  costUsd      Float?
  durationMs   Int?

  // Phase 3.1 (Section 12): small, generic, vendor-specific diagnostic
  // data (e.g. an OpenAI response id) - deliberately NOT typed columns
  // like `openaiResponseId`, so the core schema never grows a new
  // column per provider. MUST NEVER contain a credential, a full
  // prompt, or full page content - see NormalizedAiResponse's doc
  // comment in packages/ai/src/types.ts, which is what populates this.
  providerMetadata Json?

  errorMessage String?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([organizationId])
  @@map("ai_analyses")
}

// Phase 3.1 (Section 3/4): an organization's own AI provider
// configuration - the SaaS multi-tenancy requirement that Phase 3's
// single environment-variable-configured provider did not support.
// `encryptedApiKey` is ciphertext (see @cma/security's
// encryptCredential/decryptCredential) - this column must never be
// selected into any API response or log line; repository functions in
// packages/db/src/repositories/aiConnections.ts enforce that by
// returning a "safe" DTO (no key material) from every function except
// the one internal-only function the worker uses to build a provider.
//
// One organization may have multiple connections (e.g. while migrating
// from one provider to another) but at most one ENABLED one is ever
// used by the pipeline at a time - see
// getEnabledAiConnectionConfigForOrg in the repository.
model AiConnection {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  provider        String
  model           String
  baseUrl         String?
  encryptedApiKey String
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, enabled])
  @@map("ai_connections")
}

// Phase 4: one row per organization per reporting period (Section 4).
// `reportDate` is stored as a bare UTC midnight DATE-like timestamp
// representing "which calendar day this report covers", NOT the window's
// actual UTC instants - see packages/core/src/reportWindow.ts for how the
// organization's own timezone turns that date into concrete
// [startUtc, endUtc) bounds used to select ChangeEvents. `timezone` is
// persisted alongside it (not just read from Organization at generation
// time) so a report's period identity is stable even if the organization
// later changes its timezone setting.
//
// The `@@unique` below is the idempotency anchor (Section 4/9): a queue
// job retried after a crash, or two near-simultaneous scheduler ticks,
// resolve to the SAME row via upsert rather than creating a duplicate
// report for the same organization/day/timezone.
model Report {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  reportDate DateTime
  timezone   String
  status     ReportStatus @default(GENERATING)

  // Denormalized summary counts (Section 1) - computed once at generation
  // time from the ReportItems below, so the dashboard/history list never
  // has to re-aggregate on every render.
  competitorCount             Int @default(0)
  competitorsWithChangesCount Int @default(0)
  changeCount                 Int @default(0)

  errorMessage String?
  generatedAt  DateTime? // set only once status becomes COMPLETED
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items         ReportItem[]
  notifications NotificationLog[]

  @@unique([organizationId, reportDate, timezone])
  @@index([organizationId, reportDate])
  @@map("reports")
}

// Phase 4 (Section 5): a thin join between a DailyReport and the
// deterministic ChangeEvent it surfaces - deliberately NOT a copy of the
// ChangeEvent's fields (Section 5: "prefer references/relations"). Any
// AI interpretation is read through `changeEvent.aiAnalysis` at query
// time, never duplicated here either, so there is exactly one source of
// truth for both the deterministic fact and its optional AI enrichment.
//
// `@@unique([reportId, changeEventId])` makes report generation
// idempotent at the item level: re-running generateDailyReport for a
// report that already has this ChangeEvent is a no-op for that item, not
// a duplicate row.
model ReportItem {
  id             String      @id @default(cuid())
  organizationId String
  reportId       String
  report         Report      @relation(fields: [reportId], references: [id], onDelete: Cascade)
  changeEventId  String
  changeEvent    ChangeEvent @relation(fields: [changeEventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([reportId, changeEventId])
  @@index([organizationId])
  @@index([reportId])
  @@map("report_items")
}

model NotificationLog {
  id             String  @id @default(cuid())
  organizationId String
  reportId       String?
  report         Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  channel      NotificationChannel
  recipient    String
  status       NotificationStatus
  sentAt       DateTime?
  errorMessage String?
  createdAt    DateTime            @default(now())

  // Phase 4 (Section 16/17): the idempotency key for report email
  // delivery - "organization + report + channel + recipient" (reportId
  // already carries the organization, but organizationId stays on this
  // row like every other tenant table per the schema-header convention).
  // A retried "send the daily report email" job resolves to the SAME row
  // via upsert instead of sending a second email. Nullable `reportId`
  // means this constraint only applies to report-related notifications;
  // any future non-report notification channel is unaffected.
  @@unique([reportId, channel, recipient])
  @@index([organizationId])
  @@map("notification_logs")
}

// ---------------------------------------------------------------------------
// Cost tracking (Section 8 of the brief) - one row per MonitoringJob,
// written regardless of whether the job succeeded or failed.
// ---------------------------------------------------------------------------

model UsageRecord {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  monitoringJobId String?        @unique
  monitoringJob   MonitoringJob? @relation(fields: [monitoringJobId], references: [id], onDelete: SetNull)

  extractionMethod   ExtractionMethod?
  browserEscalated   Boolean           @default(false)
  aiCallMade         Boolean           @default(false)
  aiPromptTokens     Int?
  aiCompletionTokens Int?
  fetchSucceeded     Boolean
  processingTimeMs   Int
  createdAt          DateTime          @default(now())

  @@index([organizationId, createdAt])
  @@map("usage_records")
}
